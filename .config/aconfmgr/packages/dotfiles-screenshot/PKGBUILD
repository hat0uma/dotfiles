pkgname=dotfiles-screenshot
pkgver=1.0.0
pkgrel=4
pkgdesc="Hyprland screenshot helper with save, clipboard, and edit actions"
arch=('any')
url='https://github.com/hat0uma/dotfiles'
license=('custom')
depends=(
    'bash'
    'grim'
    'hyprland'
    'jq'
    'libnotify'
    'satty'
    'slurp'
    'wl-clipboard'
    'xdg-user-dirs'
    'xdg-utils'
)

source=('screenshot')
sha256sums=('3d4b46e1903850062ff404e0b2af8c01d70225bed5fa9dd3c66648fb0f7745ff')

package() {
    install -Dm755 "$srcdir/screenshot" "$pkgdir/usr/bin/screenshot"
}
