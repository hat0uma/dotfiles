pkgname=dotfiles-ttf-koruri
pkgver=20210720
pkgrel=1
pkgdesc="Japanese TrueType font based on M+ OUTLINE FONTS and Open Sans"
arch=('any')
url='https://github.com/Koruri/Koruri'
license=('Apache-2.0')
makedepends=('git')

source=(
    "Koruri::git+https://github.com/Koruri/Koruri.git#tag=${pkgver}"
)

sha256sums=(
    'SKIP'
)

package() {
    cd "$srcdir/Koruri"
    for font in *.ttf; do
        install -Dm644 "$font" "$pkgdir/usr/share/fonts/TTF/$font"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
