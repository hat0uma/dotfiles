[Unit]
Description=Select PC speaker or headphone profile from jack state
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/wireplumber/pc-jack-profile.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
